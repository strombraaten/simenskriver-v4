---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import { isValidDate } from '@/utils/markdown';
import { formatIsoDate } from '@/utils/date';
import { siteConfig } from '@/config';
import { generateHomeSEO } from '@/utils/seo';
import { shouldShowPost, sortPostsByDate, processPost, extractTags, postUrl } from '@/utils/markdown';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Icon from '@/components/Icon.astro';
import { optimizePostImagePath } from '@/utils/images';

// Get all posts and filter by visibility
const allPosts = await getCollection('posts');
const isDev = import.meta.env.DEV;
const visiblePosts = allPosts.filter(post => shouldShowPost(post, isDev));
const sortedPosts = sortPostsByDate(visiblePosts);

// Process posts for reading time and word count
const processedPosts = await Promise.all(
  sortedPosts.map(async (post) => await processPost(post))
) as any[];

const UNLISTED_POSTS = ['takk', 'privacy-policy', 'kontakt'];
const regularProcessedPosts = processedPosts.filter((p: any) => p.data.type !== 'utkast' && !UNLISTED_POSTS.includes(p.id));
const utkastProcessedPosts  = processedPosts.filter((p: any) => p.data.type === 'utkast');

// Get featured post based on configuration
let featuredPost = null;
if (siteConfig.homeOptions.featuredPost.enabled) {
  if (siteConfig.homeOptions.featuredPost.type === "latest") {
    featuredPost = regularProcessedPosts[0];
  } else if (siteConfig.homeOptions.featuredPost.type === "featured" && siteConfig.homeOptions.featuredPost.slug) {
    // Find the specific post by id (slug config value maps to post.id in v6)
    featuredPost = regularProcessedPosts.find(post => post.id === siteConfig.homeOptions.featuredPost.slug) || null;
  }
}

// Get preview posts based on whether featured post is shown
const previewPosts = featuredPost
  ? regularProcessedPosts.slice(1, siteConfig.homeOptions.recentPosts.count + 1)
  : regularProcessedPosts.slice(0, siteConfig.homeOptions.recentPosts.count);

// Get featured projects if enabled
// Get home blurb content from posts collection (draft: true, so getEntry bypasses visibility filter)
let homeBlurbContent = null;
let HomeBlurbContent = null;

if (siteConfig.homeOptions.blurb.placement !== 'none') {
  try {
    homeBlurbContent = await getEntry('posts', 'home');
    if (homeBlurbContent) {
      const { Content } = await render(homeBlurbContent);
      HomeBlurbContent = Content;
    }
  } catch (error) {
  }
}

// ── Four-view post list data ────────────────────────────────────────────────

// Year view: group posts by year, years sorted descending, posts newest-first within each year
const postsByYear: Record<number, typeof regularProcessedPosts> = {};
for (const post of regularProcessedPosts) {
  const year = new Date((post as any).data.date).getFullYear();
  if (!postsByYear[year]) postsByYear[year] = [];
  postsByYear[year].push(post);
}
const years = Object.keys(postsByYear).map(Number).sort((a, b) => b - a);

// Tag view: alphabetical tags excluding newsletter, posts grouped per tag
const EXCLUDED_TAGS = ['nyhetsbrev'];
const regularVisiblePosts = visiblePosts.filter(p => (p as any).data.type !== 'utkast');
const allTags = extractTags(regularVisiblePosts).filter(t => !EXCLUDED_TAGS.includes(t));
const postsByTag: Record<string, typeof regularProcessedPosts> = {};
for (const tag of allTags) {
  postsByTag[tag] = regularProcessedPosts.filter((post: any) => {
    const tags = Array.isArray(post.data.tags)
      ? post.data.tags
      : post.data.tags ? [post.data.tags] : [];
    return tags.some((t: string) => t?.trim() === tag);
  });
}

// Last-modified view: sort by lastModified, falling back to date
const lastModifiedPosts = [...regularProcessedPosts].sort((a: any, b: any) => {
  const dateA = a.data.lastModified ? new Date(a.data.lastModified) : new Date(a.data.date);
  const dateB = b.data.lastModified ? new Date(b.data.lastModified) : new Date(b.data.date);
  return dateB.getTime() - dateA.getTime();
});

// ── End four-view data ───────────────────────────────────────────────────────

// Determine which content types are being displayed
const hasFeaturedPost = siteConfig.homeOptions.featuredPost.enabled && featuredPost;
const hasRecentPosts = siteConfig.homeOptions.recentPosts.enabled && previewPosts.length > 0;

// Count how many content types are being displayed
const contentTypesCount = [hasFeaturedPost, hasRecentPosts].filter(Boolean).length;

// Determine if we should use special treatment (only one content type is displayed)
const useSpecialTreatment = contentTypesCount === 1;

// Determine if only blurb content should be shown (no posts)
const onlyBlurbContent = contentTypesCount === 0 && siteConfig.homeOptions.blurb.placement !== 'none' && HomeBlurbContent;

// Generate SEO data for homepage
const seoData = generateHomeSEO(Astro.url.href);
if (siteConfig.homepageTitle) seoData.title = siteConfig.homepageTitle;

// Structured data for the website
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: siteConfig.title,
  description: siteConfig.description,
  url: siteConfig.site,
  author: {
    '@type': 'Person',
    name: siteConfig.author
  },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.title,
    url: siteConfig.site
  }
};
---

<BaseLayout seoData={seoData}>
  <Fragment slot="head">
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Preload critical images - use same URL as actual img tags for caching -->
    {featuredPost && featuredPost.data.image && siteConfig.postOptions.showPostCardCoverImages === 'all' && !featuredPost.data.hideCoverImage && typeof featuredPost.data.image === 'string' && !featuredPost.data.image.startsWith('http') && (
      <link
        rel="preload"
        as="image"
        href={optimizePostImagePath(featuredPost.data.image, undefined, featuredPost.id)}
        fetchpriority="high"
      />
    )}
  </Fragment>

  <div class="py-8 relative">
    <div class="mx-auto px-4 sm:px-6 lg:px-8" style={`max-width: ${siteConfig.layout.contentWidth}`}>
      {onlyBlurbContent ? (
        <!-- Blurb-only homepage with page-like layout -->
        <article class="bg-primary-50 dark:bg-primary-900 rounded-lg border border-primary-200 dark:border-primary-700 shadow-sm">
          <div class="p-6 rounded-lg">
            <!-- Page header -->
            {homeBlurbContent?.data.title && (
              <header class="mb-4">
                <h1 class="type-title text-primary-900 dark:text-primary-50 mb-6">
                  {homeBlurbContent.data.title}
                </h1>
              </header>
            )}

            <!-- Page content -->
            <div class="prose dark:prose-dark max-w-none" id="page-content">
              {HomeBlurbContent && <HomeBlurbContent />}
            </div>
          </div>
        </article>
      ) : (regularProcessedPosts.length > 0 || utkastProcessedPosts.length > 0) ? (
        <>
          <!-- Home blurb above posts -->
          {siteConfig.homeOptions.blurb.placement === 'above' && HomeBlurbContent && (
            <section class="prose dark:prose-dark max-w-none mb-16">
              <HomeBlurbContent />
            </section>
          )}

          <!-- Featured post -->
          {siteConfig.homeOptions.featuredPost.enabled && featuredPost && (
            <section class="mb-12">
              <div class="flex items-center justify-between mb-6">
                <h2 class="text-lg font-semibold text-primary-900 dark:text-primary-50">
                  {siteConfig.homeOptions.featuredPost.type === "latest" ? "Latest Post" : "Featured Post"}
                </h2>
              </div>

              <PostCard post={featuredPost} featured={true} eager={true} context="featured" />
            </section>
          )}

          <!-- All posts — four-view switcher -->
          {siteConfig.homeOptions.recentPosts.enabled && (regularProcessedPosts.length > 0 || utkastProcessedPosts.length > 0) && (
            <section class="mb-12">

              <!-- View tabs -->
              <div class="view-tabs" role="tablist">
                <button data-view-btn="year"     class="view-tab type-meta" role="tab" aria-selected="true">År</button>
                <button data-view-btn="tag"      class="view-tab type-meta" role="tab">Tema</button>
                <button data-view-btn="modified" class="view-tab type-meta" role="tab">Sist endret</button>
                {utkastProcessedPosts.length > 0 && (
                  <button data-view-btn="utkast" class="view-tab type-meta" role="tab">Utkast</button>
                )}
              </div>

              <div id="post-views" data-view="year">

                <!-- Year view -->
                <div class="view-section view-year">
                  {years.map(year => (
                    <div class="group-block">
                      <h2 class="group-heading type-label">{year}</h2>
                      <ul class="post-list">
                        {postsByYear[year].map((post: any) => (
                          <li>
                            <a href={postUrl(post)} class="post-row">
                              <span class="post-title type-list-item">{post.data.title}</span>
                              <span class="post-date type-meta">{formatIsoDate(post.data.date)}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>

                <!-- Tag view -->
                <div class="view-section view-tag">
                  {allTags.map(tag => (
                    postsByTag[tag].length > 0 && (
                      <div class="group-block">
                        <h2 class="group-heading type-label">
                          <a href={`/posts/tag/${encodeURIComponent(tag)}`} class="tag-heading-link">{tag}</a>
                        </h2>
                        <p class="tag-count type-small">
                          {postsByTag[tag].length} {postsByTag[tag].length === 1 ? 'notat' : 'notater'} med denne emneknaggen
                        </p>
                        <ul class="post-list">
                          {postsByTag[tag].map((post: any) => (
                            <li>
                              <a href={postUrl(post)} class="post-row">
                                <span class="post-title type-list-item">{post.data.title}</span>
                                <span class="post-date type-meta">{formatIsoDate(post.data.date)}</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )
                  ))}
                </div>

                <!-- Last-modified view -->
                <div class="view-section view-modified">
                  <ul class="post-list">
                    {lastModifiedPosts.map((post: any) => {
                      const d = post.data.lastModified
                        ? new Date(post.data.lastModified)
                        : new Date(post.data.date);
                      return (
                        <li>
                          <a href={postUrl(post)} class="post-row">
                            <span class="post-title type-list-item">{post.data.title}</span>
                            <span class="post-date type-meta">{formatIsoDate(d)}</span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>

                <!-- Utkast view -->
                <div class="view-section view-utkast">
                  <ul class="post-list">
                    {utkastProcessedPosts.map((post: any) => (
                      <li>
                        <a href={postUrl(post)} class="post-row">
                          <span class="post-title type-list-item">{post.data.title}</span>
                          <span class="post-date type-meta">{formatIsoDate(post.data.date)}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

              </div>
            </section>
          )}

          <!-- Home blurb below posts -->
          {siteConfig.homeOptions.blurb.placement === 'below' && HomeBlurbContent && (
            <section class="prose dark:prose-dark max-w-none mt-16">
              <HomeBlurbContent />
            </section>
          )}

        </>
      ) : (
        <!-- Empty state -->
        <section class="text-center py-16">
          <div class="max-w-md mx-auto">
            <Icon name="file-text" class="w-16 h-16 text-primary-400 dark:text-primary-500 mx-auto mb-6" />
            <h2 class="text-2xl font-semibold text-primary-900 dark:text-primary-50 mb-4">
              No Posts Yet
            </h2>
            <p class="text-primary-600 dark:text-primary-300 mb-8">
              This blog is just getting started. Check back soon for new content!
            </p>
            {isDev && (
              <div class="p-4 bg-blue-50 dark:bg-blue-950 rounded-lg border border-blue-200 dark:border-blue-800">
                <p class="text-sm text-blue-800 dark:text-blue-200">
                  <strong>Dev Mode:</strong> Add some posts to the <code>content/posts/</code> directory to see them here.
                </p>
              </div>
            )}
          </div>
        </section>
      )}

    </div>
  </main>
</BaseLayout>

<script>
  // Hero search button functionality
  document.addEventListener('DOMContentLoaded', () => {
    const heroSearchButton = document.getElementById('hero-search-button');
    if (heroSearchButton) {
      heroSearchButton.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('openCommandPalette'));
      });
    }
  });

  // View switcher — persists selected view in localStorage
  (function () {
    const wrapper = document.getElementById('post-views');
    const buttons = document.querySelectorAll('[data-view-btn]');
    if (!wrapper || !buttons.length) return;

    function setView(view) {
      wrapper.dataset.view = view;
      localStorage.setItem('post-view', view);
      buttons.forEach(btn => {
        const isActive = btn.dataset.viewBtn === view;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
    }

    // Restore persisted view (default: year)
    setView(localStorage.getItem('post-view') || 'year');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.dataset.viewBtn) setView(btn.dataset.viewBtn);
      });
    });
  })();
</script>

<style>
  /* ── View tabs ────────────────────────────────────────────────────────────── */
  .view-tabs {
    display: flex;
    gap: 0.125rem;
    border-bottom: 1px solid;
    @apply border-line-subtle;
    margin-bottom: 1.5rem;
  }

  .view-tab {
    padding: 0.375rem 0.75rem;
    border: none;
    background: none;
    cursor: pointer;
    position: relative;
    @apply text-ink-subtle;
    transition: color 0.15s;
  }

  .view-tab:hover {
    @apply text-ink-default;
  }

  .view-tab.active {
    @apply text-ink-prominent;
  }

  /* Active underline indicator */
  .view-tab.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 2px;
    @apply bg-accent;
  }

  /* ── View sections ────────────────────────────────────────────────────────── */
  .view-section {
    display: none;
  }

  #post-views[data-view="year"]     .view-year,
  #post-views[data-view="tag"]      .view-tag,
  #post-views[data-view="modified"] .view-modified,
  #post-views[data-view="utkast"]   .view-utkast {
    display: block;
  }

  /* ── Group blocks (year / tag headings) ───────────────────────────────────── */
  .group-block {
    margin-bottom: 2rem;
  }

  /* Size, weight and letter-spacing come from .type-label */
  .group-heading {
    text-transform: uppercase;
    @apply text-ink-subtle;
    margin-bottom: 0.375rem;
  }

  .tag-heading-link {
    transition: color 0.15s;
  }

  .tag-heading-link:hover {
    @apply text-ink-link;
  }

  .tag-count {
    @apply text-ink-subtle;
    margin-bottom: 0.375rem;
  }

  /* ── Post list rows ───────────────────────────────────────────────────────── */
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }


  .post-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding: 0.5rem 0;
    @apply text-ink-prominent;
    text-decoration: none;
    transition: color 0.15s;
  }

  .post-row:hover {
    @apply text-ink-link;
  }

  .post-date {
    flex-shrink: 0;
    @apply text-ink-subtle;
  }

  .post-row:hover .post-date {
    @apply text-ink-link;
  }
</style>
